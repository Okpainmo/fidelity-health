PORT=5000
JWT_SECRET=your-jwt-secret
JWT_ACCESS_EXPIRATION_TIME=1h
JWT_SESSION_EXPIRATION_TIME=24h
JWT_ONE_TIME_PASSWORD_LIFETIME=5m

# postgresql
POSTGRES_USER=YOUR_USER_NAME
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DATABASE_NAME=multi_db_nodejs_express_with_typescript_template__db_dev
POSTGRES_DATABASE_URL=postgresql://YOUR_USER_NAME:YOUR_PASSWORD@localhost:SYSTEM_PORT/multi_db_nodejs_express_with_typescript_template__db_dev?schema=public

# web-sockets
WS_PATH=/ws
WS_HEARTBEAT_INTERVAL=30000
WS_SHUTDOWN_TIMEOUT=10000

# S3 file storage (images: profile photos; files: record attachments).
# Keep both buckets PRIVATE - the API hands out short-lived signed URLs.
AWS_IMAGES_ENABLED=false
AWS_IMAGES_ACCESS_KEY=
AWS_IMAGES_SECRET_ACCESS_KEY=
AWS_IMAGES_S3_BUCKET_REGION=
AWS_IMAGES_S3_BUCKET_NAME=

AWS_FILES_ENABLED=false
AWS_FILES_ACCESS_KEY=
AWS_FILES_SECRET_ACCESS_KEY=
AWS_FILES_S3_BUCKET_REGION=
AWS_FILES_S3_BUCKET_NAME=

# service details
SERVICE_NAME="ws-server"

# Missie (AI assistant) - any OpenAI-compatible endpoint, e.g. Amazon Bedrock
OPENAI_API_KEY=
OPENAI_BASE_URL=
MISSIE_MODEL=openai.gpt-oss-120b
